# Copy to backend.tf (git-ignored, like terraform.tfvars) once a Hetzner
# Object Storage bucket exists, then run `terraform init -migrate-state` from
# wherever the current terraform.tfstate lives. This replaces the single
# local state file with one durable, versioned copy — see README.md → State.
#
# Credentials: set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY to the Object
# Storage access key pair (not HCLOUD_TOKEN — Object Storage has its own
# keys, generated separately in the Hetzner console). Never put them in this
# file.
#
# Enable object versioning on the bucket at creation time. Without it, a bad
# apply overwrites the only remote copy and there is nothing to roll back to,
# which is the failure this whole change exists to prevent.
terraform {
  backend "s3" {
    bucket = "frontdesk-tfstate" # replace with the real bucket name

    key = "hetzner/terraform.tfstate"

    # Hetzner's region is the location id and must match the endpoint host:
    # fsn1 (Falkenstein), nbg1 (Nuremberg), or hel1 (Helsinki). nbg1 keeps
    # state next to the node, which also lives in nbg1 (ADR-0010).
    region = "nbg1"

    endpoints = {
      s3 = "https://nbg1.your-objectstorage.com"
    }

    # Terraform-native state locking via a lock object in the same bucket.
    # This is why versions.tf sets required_version >= 1.10. No DynamoDB
    # equivalent exists here, so without this two concurrent applies can
    # interleave and corrupt state.
    use_lockfile = true

    # Hetzner's S3-compatible endpoint isn't AWS: skip the AWS-specific checks.
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
    use_path_style              = true
  }
}
