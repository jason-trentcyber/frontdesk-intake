# env / secrets
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example
kubeconfig*
*.pem

# node
node_modules/
.next/
dist/
.turbo/
coverage/
next-env.d.ts
*.tsbuildinfo

# Playwright (ADR-0030)
web/playwright-report.json
web/test-results/

# python
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/

# fetched by worker/scripts/fetch_model.py (ADR-0023 Consequences), baked
# into the image by worker/Dockerfile - not committed, ~130 MB
worker/models/

# terraform
.terraform/
*.tfstate
*.tfstate.*

# helm
deploy/chart/charts/
*.tgz

# misc
.DS_Store
*.log
.idea/
.vscode/
!.vscode/extensions.json

# generated by the hetzner root
infra/hetzner/kubeconfig
!deploy/bootstrap/sealed-secrets-pub.pem

# Grafana admin password (ADR-0026); the stack is brought up by hand on the VPS.
deploy/observability/.env

# archify visual-check evidence (ADR-0034): four PNG captures, a contact sheet
# and a JSON receipt, regenerated on every run. The artifact they attest to is
# committed; the ~700 KB of evidence is not.
docs/diagrams/*.visual-check.*
# Written by the pages workflow at build time, never committed.
docs/diagrams/index.html

# Written by `next dev` (next@16 generate-agent-files.js), not by us. A
# web/AGENTS.md would shadow the repo-root AGENTS.md for agents working in
# web/, and it regenerates on every dev run.
web/AGENTS.md
web/CLAUDE.md

# #31: exported eval candidates may contain text a stranger typed into the
# public form. They are curated by hand into evals/golden/, never committed raw.
evals/candidates/*
!evals/candidates/README.md
