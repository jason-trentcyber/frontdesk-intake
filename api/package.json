{
  "name": "@frontdesk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @frontdesk/db build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @frontdesk/db build",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1130.0",
    "@frontdesk/db": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "eslint": "^10.10.0",
    "prettier": "^3.3.3",
    "tsx": "4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^2.1.3"
  }
}
