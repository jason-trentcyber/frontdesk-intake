{
  "name": "@frontdesk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @frontdesk/db build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @frontdesk/db build",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1163.0",
    "@frontdesk/db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
