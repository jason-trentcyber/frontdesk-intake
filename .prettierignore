# Generated by z.toJSONSchema() (api/src/queue/triage-message-schema.test.ts
# and ingest-message-schema.test.ts each assert their committed file equals a
# fresh regeneration byte-for-byte, #23/ADR-0025) - not hand-written. Prettier
# would collapse the "required" array onto one line, which
# JSON.stringify(schema, null, 2) never does; formatting it here would just
# make it fail the drift check on the next regeneration. Same reasoning as
# pnpm-lock.yaml above: exact-match generated files, not prose to style. A
# glob, not two literal names, so a future third contract file doesn't need
# this file touched again.
docs/contracts/*.schema.json
