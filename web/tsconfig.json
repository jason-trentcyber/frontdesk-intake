{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Next 16 requires react-jsx (the React automatic runtime) and
    // rewrites this key on `next build` if it says "preserve" - committing
    // what it wants so the build is not a source of uncommitted drift.
    "jsx": "react-jsx",
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }]
  },
  // .next/dev/types is new in Next 16 and is added by `next build` for the
  // same reason as above.
  "include": [
    "next-env.d.ts",
    "src",
    "*.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
