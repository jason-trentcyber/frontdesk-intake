# Copy to .env and adjust as needed. .env is git-ignored; this file is not.
# See docs/conventions.md → Configuration.

# --- Postgres (pgvector + pgmq, ADR-0016), used by api/ and worker/ ---
# POSTGRES_USER/PASSWORD are the postgres superuser, used by the container
# entrypoint and the backup CronJob only - nothing app-facing authenticates
# as it. deploy/postgres/initdb/002-roles.sh creates the two roles below at
# first start; frontdesk owns the database and runs migrations (#21),
# frontdesk_app is the runtime role (DML only, RLS applies to it - ADR-0007).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=frontdesk
FRONTDESK_PASSWORD=frontdesk
FRONTDESK_APP_PASSWORD=frontdesk_app
# Owner role - migrations only (Prisma, #21). Never mounted by web/api/worker
# at runtime; that split is enforced in the cluster by which sealed-secret
# key each Deployment's env references (deploy/postgres/README.md), and
# mirrored here so local dev matches: DATABASE_URL is for `prisma migrate`,
# DATABASE_APP_URL is what api/ and worker/ actually connect with.
DATABASE_URL=postgresql://frontdesk:frontdesk@localhost:5432/frontdesk
DATABASE_APP_URL=postgresql://frontdesk_app:frontdesk_app@localhost:5432/frontdesk

# --- Queue (ADR-0004): pgmq in production, sqs adapter tested against LocalStack ---
QUEUE_PROVIDER=pgmq

# --- LLM (ADR-0006): fake for local dev/tests, never openrouter/bedrock outside worker/llm/ ---
LLM_PROVIDER=fake
LLM_MODEL=haiku
OPENROUTER_API_KEY=

# --- LocalStack (SQS only, for the sqs adapter contract tests) ---
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Public form spam protection (infra/cloudflare, #17) ---
# Public site key, safe to commit. The matching secret key is a Kubernetes
# SealedSecret (deploy/chart/sealed/), never an env var in this file.
TURNSTILE_SITE_KEY=0x4AAAAAAEtBmgvARsd60xeS

# --- Podman users: see docs/conventions.md → Toolchain ---
# export DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock
# export TESTCONTAINERS_RYUK_DISABLED=true
