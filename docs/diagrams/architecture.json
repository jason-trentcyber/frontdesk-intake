  "cards": [
    {
      "dot": "cyan",
      "title": "Request path & tenancy",
      "items": [
        "One Ingress splits /api to Fastify; / and /api/auth to Next.js",
        "web submits through api server-side — api is the sole queue producer (ADR-0021)",
        "RLS compares org_id to current_org_id() on every tenant table (ADR-0018)"
      ]
    },
    {
      "dot": "amber",
      "title": "Switch-proof adapters",
      "items": [
        "LLM_PROVIDER swaps OpenRouter ↔ Bedrock behind one interface (ADR-0006)",
        "QUEUE_PROVIDER swaps pgmq ↔ SQS behind one interface (ADR-0004)",
        "A provider-parity CI job proves the unwired adapters still match"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery & operations",
      "items": [
        "Deploy runs only after CI is green on main, over the tailnet (ADR-0014)",
        "Secrets live in git as SealedSecret ciphertext, decrypted in-cluster",
        "Prometheus and Grafana run off-node, so graphs outlive the node (ADR-0026)"
      ]
    }
  ]
